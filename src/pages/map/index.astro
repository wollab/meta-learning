---
import BaseLayout from '../../layouts/BaseLayout.astro';import PageIntro from '../../components/PageIntro.astro';import {archive,byId,relationLabels} from '../../data/theories';import {ArrowRight,GitFork} from 'lucide-astro';const base=import.meta.env.BASE_URL;
---
<BaseLayout title="แผนที่ความสัมพันธ์ | Meta Learning"><div class="page-shell"><PageIntro eyebrow="Ideas do not move in one line" title="แผนที่ความสัมพันธ์" lead="ลูกศรแต่ละเส้นระบุชนิด แหล่งรองรับ และระดับความมั่นใจ ไม่ได้แปลว่าแนวคิดหนึ่งเป็นสาเหตุของอีกแนวคิดโดยอัตโนมัติ"/><section class="relation-filter"><label><span>ดูความสัมพันธ์</span><select id="relation-type"><option value="">ทุกชนิด</option>{archive.relationshipTypes.map(x=><option value={x}>{relationLabels[x]}</option>)}</select></label><div><GitFork/><strong id="relation-count">{archive.relationships.length} เส้น</strong></div></section><div class="relation-map">{archive.relationships.map(edge=>{const from=byId.get(edge.fromId),to=byId.get(edge.toId);const confidence=edge.confidence==='high'?'สูง':edge.confidence==='medium'?'ปานกลาง':'ต่ำ';return <article data-type={edge.type}><a href={`${base}theories/${from?.slug}/`}><small>จาก</small><strong>{from?.titleTh}</strong></a><div><span>{relationLabels[edge.type]}</span><ArrowRight/></div><a href={`${base}theories/${to?.slug}/`}><small>ไปยัง</small><strong>{to?.titleTh}</strong></a><p>{edge.summary}<span class="relation-meta">หลักฐาน {edge.sourceIds.length} แหล่ง · ความมั่นใจ {confidence}</span></p></article>})}</div><p class="empty-state" hidden>ยังไม่มีเส้นความสัมพันธ์ชนิดนี้</p></div><script is:inline>const select=document.querySelector('#relation-type'),items=[...document.querySelectorAll('.relation-map article')],count=document.querySelector('#relation-count'),empty=document.querySelector('.empty-state');select.addEventListener('change',()=>{let n=0;items.forEach(x=>{const show=!select.value||x.dataset.type===select.value;x.hidden=!show;if(show)n++});count.textContent=`${n} เส้น`;empty.hidden=n!==0});</script></BaseLayout>
