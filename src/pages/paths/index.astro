---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { archive, byId, kindLabels } from '../../data/theories';
import { ArrowRight, Baby, BookOpenCheck, BriefcaseBusiness, Compass, GraduationCap, Network, Scale, Sprout, Users } from 'lucide-astro';

const base = import.meta.env.BASE_URL;
const focus = [
  { id: 'syn-11', label: 'เด็กและพัฒนาการ', icon: Baby, tone: 'turquoise' },
  { id: 'syn-12', label: 'ผู้ใหญ่และการทำงาน', icon: BriefcaseBusiness, tone: 'yellow' },
  { id: 'syn-13', label: 'พัฒนาตนเอง', icon: Sprout, tone: 'violet' },
  { id: 'syn-06', label: 'Pedagogy และการออกแบบการสอน', icon: GraduationCap, tone: 'turquoise' },
  { id: 'syn-04', label: 'เรียนให้จำและคิดได้ดีขึ้น', icon: BookOpenCheck, tone: 'yellow' },
  { id: 'syn-05', label: 'เรียนรู้ร่วมกับคนอื่น', icon: Users, tone: 'violet' },
  { id: 'syn-08', label: 'Critical / Inclusive Pedagogy', icon: Scale, tone: 'turquoise' },
  { id: 'syn-09', label: 'Digital และ networked learning', icon: Network, tone: 'yellow' },
];
const paths = archive.syntheses.filter((path) => path.evidenceStatus === 'public-ready');
const focusById = new Map(focus.map((item) => [item.id, item]));
---

<BaseLayout title="เริ่มอ่านตามเป้าหมาย | Meta Learning">
  <div class="page-shell path-page">
    <PageIntro eyebrow="ไม่ต้องเริ่มจากชื่อทฤษฎี" title="วันนี้คุณอยากเข้าใจการเรียนรู้เรื่องไหน?" lead="เลือกจากผู้เรียนและเป้าหมายก่อน แล้วค่อยเปิดแนวคิดต่างชนิดมาเทียบกัน เส้นทางเหล่านี้เป็นคำแนะนำในการอ่าน ไม่ใช่คำวินิจฉัยว่าคนกลุ่มหนึ่งต้องเรียนแบบใดแบบหนึ่ง" />

    <section class="path-focus" aria-labelledby="focus-title">
      <div class="section-title playful-title"><div><p class="eyebrow">ทางเข้าที่ถามบ่อย</p><h2 id="focus-title">เริ่มจากเป้าหมายของคุณ</h2></div></div>
      <div class="focus-grid">
        {focus.map(({ id, label, icon: Icon, tone }) => {
          const path = paths.find((item) => item.id === id);
          return <a class={`focus-card ${tone}`} href={`#${id}`}><Icon /><span><strong>{label}</strong><small>{path?.summary}</small></span><ArrowRight /></a>;
        })}
      </div>
      <p class="path-caution"><strong>Pedagogy, Andragogy, Heutagogy ไม่ใช่บันไดอายุสามขั้น:</strong> pedagogy ใช้เป็นคำกว้างเรื่องการสอนได้ด้วย, andragogy เป็นกรอบสมมติฐานเรื่องผู้ใหญ่ที่มีข้อถกเถียง และ heutagogy เป็นแนวทาง learner-determined ที่ยังไม่ได้เป็นระเบียนในคลังรอบนี้</p>
    </section>

    <section class="path-library" aria-labelledby="all-paths-title">
      <div class="section-title playful-title"><div><p class="eyebrow">13 เส้นทางจากฐานวิจัย</p><h2 id="all-paths-title">หรือเริ่มจากคำถามที่สนใจ</h2></div><a href={`${base}theories/`}>ดูคลังทั้งหมด <ArrowRight /></a></div>
      <div class="path-grid">
        {paths.map((path, index) => {
          const special = focusById.get(path.id);
          return <article class:list={['path-card', special?.tone]} id={path.id}>
            <div class="path-card-head"><span>{String(index + 1).padStart(2, '0')}</span>{special ? <strong>{special.label}</strong> : <Compass size={20} />}</div>
            <h2>{path.title}</h2>
            <p>{path.summary}</p>
            <ol>
              {path.theoryIds.map((id) => {
                const item = byId.get(id);
                return <li><a href={`${base}theories/${item?.slug}/`}><span><strong>{item?.titleTh}</strong><small>{item ? kindLabels[item.kind] : ''}</small></span><ArrowRight /></a></li>;
              })}
            </ol>
          </article>;
        })}
      </div>
    </section>
  </div>
</BaseLayout>
