---
import BaseLayout from '../../layouts/BaseLayout.astro';import {archive,byId,sourceById,kindLabels,familyLabels,periodLabels,relationLabels} from '../../data/theories';import {ArrowLeft,ArrowRight,ExternalLink} from 'lucide-astro';export function getStaticPaths(){return archive.theories.map(item=>({params:{slug:item.slug},props:{item}}))}const {item}=Astro.props;const base=import.meta.env.BASE_URL;const sources=item.sourceIds.map(id=>sourceById.get(id)).filter(Boolean);const outgoing=archive.relationships.filter(x=>x.fromId===item.id),incoming=archive.relationships.filter(x=>x.toId===item.id);
---
<BaseLayout title={`${item.titleTh} (${item.titleEn}) | Meta Learning`} description={item.oneSentence}><article class="detail-shell"><a class="back-link" href={`${base}theories/`}><ArrowLeft/> กลับไปคลังแนวคิด</a><header class="detail-header"><div class="card-kicker"><span>{kindLabels[item.kind]}</span><span>{periodLabels[item.period]}</span></div><h1>{item.titleTh}</h1><p class="english-title">{item.titleEn}</p><p>{item.oneSentence}</p><div class="pill-row"><span>{familyLabels[item.family]}</span><span>{item.origin}</span>{item.people.map(x=><span>{x}</span>)}</div></header><div class="detail-grid"><div class="article-body"><section><h2>แนวคิดนี้มองการเรียนรู้อย่างไร</h2><dl class="fact-list"><div><dt>มุมมองต่อผู้เรียน</dt><dd>{item.learnerView}</dd></div><div><dt>กลไกที่เสนอ</dt><dd>{item.mechanism}</dd></div><div><dt>บทบาทผู้สอนและสิ่งแวดล้อม</dt><dd>{item.teacherRole}</dd></div><div><dt>แรงจูงใจ</dt><dd>{item.motivation}</dd></div></dl></section><section><h2>อิทธิพลกับสถานะหลักฐาน</h2><div class="evidence-block influence"><strong>อิทธิพลทางประวัติศาสตร์</strong><p>{item.historicalInfluence}</p></div><div class="evidence-block current"><strong>หลักฐานปัจจุบัน</strong><p>{item.currentEvidence}</p></div><div class="evidence-block critique"><strong>ข้อวิจารณ์และขอบเขต</strong><p>{item.critiques}</p></div></section><section><h2>นำไปใช้อย่างไร</h2><div class="application-list">{item.applications.map(x=><span>{x}</span>)}</div><p class="misuse"><strong>ข้อควรระวัง</strong>{item.misuseWarning}</p></section><section><h2>ความสัมพันธ์กับแนวคิดอื่น</h2><div class="relation-list">{[...outgoing,...incoming].map(edge=>{const isOut=edge.fromId===item.id;const other=byId.get(isOut?edge.toId:edge.fromId);return <a href={`${base}theories/${other?.slug}/`}><span>{isOut?relationLabels[edge.type]:`เกี่ยวข้อง: ${relationLabels[edge.type]}`}</span><strong>{other?.titleTh}</strong><p>{edge.summary}</p><ArrowRight/></a>})}</div></section></div><aside class="source-panel"><h2>แหล่งตั้งต้น</h2>{sources.map((s:any,index)=><article><span>{String(index+1).padStart(2,'0')}</span><div><strong>{s.title}</strong><small>{s.publisher} · {s.role}</small>{s.url?<a href={s.url} target="_blank" rel="noreferrer">เปิดต้นทาง <ExternalLink/></a>:<small>ยังไม่มีลิงก์ฉบับเปิดที่ตรวจแล้ว</small>}</div></article>)}<a class="text-link" href={`${base}method/`}>วิธีประเมินสถานะหลักฐาน</a></aside></div></article></BaseLayout>
