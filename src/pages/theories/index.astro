---
import BaseLayout from '../../layouts/BaseLayout.astro';import PageIntro from '../../components/PageIntro.astro';import TheoryCard from '../../components/TheoryCard.astro';import {archive,kindLabels,familyLabels,periodLabels} from '../../data/theories';import {Search,SlidersHorizontal} from 'lucide-astro';const kinds=[...new Set(archive.theories.map(x=>x.kind))],families=[...new Set(archive.theories.map(x=>x.family))],periods=[...new Set(archive.theories.map(x=>x.period))];
---
<BaseLayout title="คลังแนวคิด | Meta Learning"><div class="page-shell"><PageIntro eyebrow="Theory is a type, not a catch-all" title="คลังแนวคิดการเรียนรู้" lead="ค้นทั้งปรัชญา ธรรมเนียมทางความคิด ทฤษฎี แบบจำลอง กรอบออกแบบ แนวการสอน และข้อเสนอที่หลักฐานไม่รองรับ"/><section class="filter-panel"><label class="search-field"><Search/><span class="sr-only">ค้นหา</span><input id="search" type="search" placeholder="ค้นชื่อ แนวคิด หรือบุคคล"/></label><label><span>ชนิด</span><select id="kind"><option value="">ทุกชนิด</option>{kinds.map(x=><option value={x}>{kindLabels[x]}</option>)}</select></label><label><span>ตระกูล</span><select id="family"><option value="">ทุกตระกูล</option>{families.map(x=><option value={x}>{familyLabels[x]}</option>)}</select></label><label><span>ช่วงเวลา</span><select id="period"><option value="">ทุกช่วงเวลา</option>{periods.map(x=><option value={x}>{periodLabels[x]}</option>)}</select></label><div class="filter-count"><SlidersHorizontal/><span id="count">{archive.theories.length} รายการ</span></div></section><div class="card-grid archive-grid">{archive.theories.map(item=><TheoryCard item={item}/>)}</div><p class="empty-state" hidden>ไม่พบแนวคิดที่ตรงกับตัวกรอง</p></div><script is:inline>const cards=[...document.querySelectorAll('.theory-card')],q=document.querySelector('#search'),k=document.querySelector('#kind'),f=document.querySelector('#family'),p=document.querySelector('#period'),c=document.querySelector('#count'),e=document.querySelector('.empty-state'),u=new URLSearchParams(location.search);if(u.get('kind'))k.value=u.get('kind');function run(){let n=0;cards.forEach(x=>{const s=(!q.value||x.dataset.search.includes(q.value.toLowerCase()))&&(!k.value||x.dataset.kind===k.value)&&(!f.value||x.dataset.family===f.value)&&(!p.value||x.dataset.period===p.value);x.hidden=!s;if(s)n++});c.textContent=`${n} รายการ`;e.hidden=n!==0}[q,k,f,p].forEach(x=>x.addEventListener('input',run));run();</script></BaseLayout>
