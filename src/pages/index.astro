---
import BaseLayout from '../layouts/BaseLayout.astro';
import TheoryCard from '../components/TheoryCard.astro';
import { archive } from '../data/theories';
import { ArrowRight, BookOpen, Clock3, Compass, GitFork, Search, ShieldCheck, Sparkles, Users } from 'lucide-astro';

const base = import.meta.env.BASE_URL;
const featured = ['lt-skinner', 'lt-piaget', 'lt-vygotsky', 'lt-bandura']
  .map((id) => archive.theories.find((item) => item.id === id))
  .filter(Boolean);
const questions = [
  {
    number: '01',
    title: 'ทำไมการฝึกบางแบบช่วยให้จำ แต่บางแบบทำให้หมดแรง?',
    detail: 'เทียบการเสริมแรง การเรียกคืน และการกำกับตนเอง',
    ids: 'lt-skinner,lt-retrieval,lt-srl',
    tone: 'turquoise',
  },
  {
    number: '02',
    title: 'เราสร้างความเข้าใจใหม่จากประสบการณ์เดิมได้อย่างไร?',
    detail: 'ดูพัฒนาการ การเรียนรู้อย่างมีความหมาย และการสร้างชิ้นงาน',
    ids: 'lt-piaget,lt-ausubel,lt-constructionism',
    tone: 'yellow',
  },
  {
    number: '03',
    title: 'การเรียนรู้ร่วมกับผู้อื่นช่วยให้เราเก่งขึ้นจริงหรือ?',
    detail: 'สำรวจการช่วยเหลือ แบบอย่าง และชุมชนนักปฏิบัติ',
    ids: 'lt-vygotsky,lt-bandura,lt-community-practice',
    tone: 'violet',
  },
];
---

<BaseLayout title="Meta Learning | มาเรียนรู้ว่าเราเรียนรู้กันอย่างไร">
  <section class="question-hero">
    <div class="question-copy">
      <p class="play-note">สวัสดี นักสำรวจ!</p>
      <h1>Meta Learning</h1>
      <p class="hero-lead">เว็บนี้คือแผนที่ช่วยให้คุณรู้ว่า “เราเรียนรู้กันอย่างไร” เริ่มจากคำถามของตัวเอง แล้วเชื่อมไปยังแนวคิด หลักฐาน เครื่องมือสะท้อน และการออกแบบ learning outcome</p>
      <div class="question-list" aria-label="เลือกคำถามเพื่อเริ่มสำรวจ">
        {questions.map((question) => (
          <a class={`question-row ${question.tone}`} href={`${base}compare/?ids=${question.ids}`}>
            <span>{question.number}</span>
            <strong>{question.title}<small>{question.detail}</small></strong>
            <ArrowRight aria-hidden="true" />
          </a>
        ))}
      </div>
      <form class="home-search" action={`${base}theories/`} method="get">
        <Search size={20} />
        <label class="sr-only" for="home-query">ค้นหาแนวคิด</label>
        <input id="home-query" name="q" type="search" placeholder="ค้นหาแนวคิด กรอบคิด หรือผู้คิดค้น..." />
        <button type="submit">ค้นหา</button>
      </form>
    </div>
    <div class="question-map">
      <img src={`${base}images/doodles/learning-map.png`} alt="ภาพวาดแสดงวิธีเรียนรู้ผ่านการฝึก การสร้างความเข้าใจ การร่วมมือ และการคิดทบทวน" />
      <div class="map-labels" aria-label="ตัวอย่างกลุ่มแนวคิด">
        <a href={`${base}theories/?family=behavioral`}>พฤติกรรม</a>
        <a href={`${base}theories/?family=cognitive`}>การรู้คิด</a>
        <a href={`${base}theories/?family=social-cultural`}>สังคมและวัฒนธรรม</a>
      </div>
      <a class="text-action" href={`${base}map/`}>เปิดแผนที่ความสัมพันธ์ <ArrowRight /></a>
    </div>
  </section>

  <section class="quick-stats" aria-label="ขนาดคลังข้อมูล">
    <span><strong>{archive.theories.length}</strong> แนวคิดและกรอบ</span>
    <span><strong>{archive.relationships.length}</strong> ความสัมพันธ์</span>
    <span><strong>{archive.sources.length}</strong> แหล่งที่ถูกอ้างถึง</span>
  </section>

  <section class="play-section flywheel-section">
    <div class="section-title playful-title">
      <div><p class="eyebrow">Learning Flywheel</p><h2>ใช้เว็บนี้เป็นวงจร ไม่ใช่สารานุกรมหน้าเดียว</h2></div>
      <p>เริ่มจากโจทย์จริงของคุณ แล้ววนกลับมาทดลอง อ่านเพิ่ม และปรับวิธีเรียนรู้ของตัวเองให้ดีขึ้น</p>
    </div>
    <div class="flywheel-grid">
      <a href="https://wollab.github.io/WoL_GameLab/9-learning-angles/?utm_source=meta_learning&utm_medium=ecosystem_link&utm_campaign=learning_flywheel" data-wol-event="ecosystem_link" data-wol-target="9-learning-angles">
        <span>1</span><strong>รู้จักท่าการเรียนรู้</strong><small>ดู Learning Move ที่คุณกำลังใช้บ่อย</small>
      </a>
      <a href={`${base}paths/`} data-wol-event="ecosystem_link" data-wol-target="meta-learning-paths">
        <span>2</span><strong>อ่านแนวคิดที่เกี่ยวข้อง</strong><small>เลือกตามเด็ก ผู้ใหญ่ self-development pedagogy หรือโจทย์อื่น</small>
      </a>
      <a href="https://wollab.github.io/WoL_Tarot_of_Learning/?utm_source=meta_learning&utm_medium=ecosystem_link&utm_campaign=learning_flywheel" data-wol-event="ecosystem_link" data-wol-target="tarot-of-learning">
        <span>3</span><strong>สะท้อนคำถามวันนี้</strong><small>ใช้ไพ่เป็น prompt เพื่อเปิดมุมมองใหม่</small>
      </a>
      <a href="https://wollab.github.io/WizardHat_LearningOutcome/?utm_source=meta_learning&utm_medium=ecosystem_link&utm_campaign=learning_flywheel" data-wol-event="ecosystem_link" data-wol-target="wizardhat-learning-outcome">
        <span>4</span><strong>ออกแบบ outcome</strong><small>แปลงกิจกรรมหรือเกมเป็นสมมติฐานที่นำไปทดสอบต่อ</small>
      </a>
    </div>
  </section>

  <section class="play-section journey-section">
    <div class="section-title playful-title">
      <div><p class="eyebrow">เลือกวิธีสำรวจ</p><h2>ดูเรื่องเดียวกันได้หลายมุม</h2></div>
      <p>เริ่มจากสิ่งที่คุณอยากเข้าใจก่อน ไม่จำเป็นต้องอ่านตามลำดับ</p>
    </div>
    <div class="journey-list">
      <a href={`${base}paths/`}><Compass /><span><strong>เริ่มจากเป้าหมายของฉัน</strong><small>เด็ก ผู้ใหญ่ การทำงาน พัฒนาตนเอง และโจทย์การเรียนรู้อื่น</small></span><ArrowRight /></a>
      <a href={`${base}timeline/`}><Clock3 /><span><strong>เดินตามเส้นเวลา</strong><small>ดูว่าความคิดแต่ละสายเกิดและเปลี่ยนอย่างไร</small></span><ArrowRight /></a>
      <a href={`${base}compare/`}><GitFork /><span><strong>ลองเทียบคำอธิบาย</strong><small>วางแนวคิด 3 แบบบนสถานการณ์เดียวกัน</small></span><ArrowRight /></a>
      <a href={`${base}tools/`}><Sparkles /><span><strong>ใช้คู่กับเครื่องมือ WoL</strong><small>เริ่มจาก Learning Move สะท้อนด้วย Tarot แล้วออกแบบ outcome ต่อด้วย Wizard Hat</small></span><ArrowRight /></a>
      <a href={`${base}theories/`}><BookOpen /><span><strong>เปิดคลังแนวคิด</strong><small>ค้นตามตระกูล ช่วงเวลา และชนิดของแนวคิด</small></span><ArrowRight /></a>
      <a href={`${base}method/`}><ShieldCheck /><span><strong>อ่านสถานะหลักฐาน</strong><small>แยกอิทธิพลทางประวัติศาสตร์ออกจากหลักฐานปัจจุบัน</small></span><ArrowRight /></a>
      <a href={`${base}people/`}><Users /><span><strong>สำรวจผู้คนและชุมชน</strong><small>ใช้รายชื่อเป็นทางเข้าหาผลงาน ไม่ลดประวัติศาสตร์เหลือคนเดียว</small></span><ArrowRight /></a>
    </div>
  </section>

  <section class="play-section featured-section">
    <div class="section-title playful-title">
      <div><p class="eyebrow">จุดเริ่มต้นที่คุ้นชื่อ</p><h2>ลองเปิดดูหนึ่งแนวคิด</h2></div>
      <a href={`${base}theories/`}>ดูทั้งหมด <ArrowRight /></a>
    </div>
    <div class="card-grid">{featured.map((item: any) => <TheoryCard item={item} />)}</div>
  </section>
</BaseLayout>
