{
  "name": "global-learning-theories-history",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "npm run sync:data && astro dev",
    "dev:lan": "npm run sync:data && astro dev --host 0.0.0.0 --port 4328",
    "sync:data": "node scripts/sync-data.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "build": "npm run sync:data && npm run validate:data && astro check && astro build && node scripts/validate-links.mjs",
    "build:pages": "npm run validate:data && astro check && astro build && node scripts/validate-links.mjs",
    "preview": "astro preview",
    "preview:lan": "astro preview --host 0.0.0.0 --port 4328"
  },
  "dependencies": { "@astrojs/check": "latest", "astro": "latest", "lucide-astro": "latest", "typescript": "latest" }
}
